using Hospital.domain.ports;
using Hospital.domain.model;
using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using Microsoft.Data.SqlClient;
using System.Windows.Forms;
using System.Net.Mail;

namespace Hospital.infraestructure.adapters.output
{
    public class SqlEmployeePort : Employee_port
    {
        private SqlConnection GetConn() => new SqlConnection(Config.SqlConnectionString);

        // Helper original method adaptada a privada
        private User FindByDocument(long document)
        {
            const string sql = @"
                SELECT TOP (1) employee_id, document, name, email, cellphone, role, date_created
                FROM dbo.employees
                WHERE document = @doc";

            using var cn = GetConn();
            cn.Open();
            using var cmd = new SqlCommand(sql, cn);
            cmd.Parameters.AddWithValue("@doc", document);

            using var rd = cmd.ExecuteReader(CommandBehavior.SingleRow);
            return rd.Read() ? MapUser(rd) : null;
        }

        private User FindByName(string name)
        {
            const string sql = @"
                SELECT TOP (1) employee_id, document, name, email, cellphone, role, date_created
                FROM dbo.employees
                WHERE name = @name";

            using var cn = GetConn();
            cn.Open();
            using var cmd = new SqlCommand(sql, cn);
            cmd.Parameters.AddWithValue("@name", name ?? string.Empty);

            using var rd = cmd.ExecuteReader(CommandBehavior.SingleRow);
            return rd.Read() ? MapUser(rd) : null;
        }

        // Implementación de la interfaz adaptando los parámetros legacy
        public User FindById1(User user)
        {
            if (user == null) return null;
            return FindByDocument(user.Id);
        }

        public User FindByName_user(User user)
        {
            if (user == null) return null;
            return FindByName(user.Name ?? string.Empty);
        }

        public void Save(User user)
        {
            const string sql = @"
                INSERT INTO dbo.employees (employee_id, document, name, email, cellphone, role, date_created)
                VALUES (@id, @doc, @name, @email, @cellphone, @role, @dateCreated)";

            using var cn = GetConn();
            cn.Open();
            using var cmd = new SqlCommand(sql, cn);
            cmd.Parameters.AddWithValue("@id", Guid.NewGuid().ToString());
            cmd.Parameters.AddWithValue("@doc", user.Id);
            cmd.Parameters.AddWithValue("@name", user.Name ?? "");
            cmd.Parameters.AddWithValue("@email", user.Email?.Address ?? "");
            cmd.Parameters.AddWithValue("@cellphone", user.Cellphone);
            cmd.Parameters.AddWithValue("@role", user.Rol ?? "");
            cmd.Parameters.AddWithValue("@dateCreated", DateTime.Now);

            cmd.ExecuteNonQuery();
        }

        public void Update(User existingUser)
        {
            const string sql = @"
                UPDATE dbo.employees 
                SET name = @name, email = @email, cellphone = @cellphone, role = @role
                WHERE document = @doc";

            using var cn = GetConn();
            cn.Open();
            using var cmd = new SqlCommand(sql, cn);
            cmd.Parameters.AddWithValue("@doc", existingUser.Id);
            cmd.Parameters.AddWithValue("@name", existingUser.Name ?? "");
            cmd.Parameters.AddWithValue("@email", existingUser.Email?.Address ?? "");
            cmd.Parameters.AddWithValue("@cellphone", existingUser.Cellphone);
            cmd.Parameters.AddWithValue("@role", existingUser.Rol ?? "");

            cmd.ExecuteNonQuery();
        }

        public void Delete(User user)
        {
            const string sql = @"DELETE FROM dbo.employees WHERE document = @doc";
            using var cn = GetConn();
            cn.Open();
            using var cmd = new SqlCommand(sql, cn);
            cmd.Parameters.AddWithValue("@doc", user.Id);
            cmd.ExecuteNonQuery();
        }

        public void Search(User user)
        {
            // Implementación de búsqueda si es necesaria por la aplicación
            // Por ahora no hace nada
        }

        private static User MapUser(SqlDataReader rd)
        {
            var u = new User();

            u.Id = rd["document"] != DBNull.Value ? Convert.ToInt64(rd["document"]) : 0L;
            u.Name = rd["name"]?.ToString() ?? "";
            var emailStr = rd["email"]?.ToString();
            u.Email = !string.IsNullOrWhiteSpace(emailStr) ? new MailAddress(emailStr) : null;
            u.Cellphone = rd["cellphone"] != DBNull.Value ? Convert.ToInt64(rd["cellphone"]) : 0L;
            u.Rol = rd["role"]?.ToString() ?? "";

            return u;
        }
    }
}