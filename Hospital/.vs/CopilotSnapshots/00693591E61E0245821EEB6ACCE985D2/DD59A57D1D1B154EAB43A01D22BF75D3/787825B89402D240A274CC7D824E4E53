    public static class DependencyInjectionConfig
    {
        public static void ConfigureServices()
        {
            // Adaptadores existentes en el proyecto
            Patient_port patientPort = new SQLPatientPort();
            var employeePort = new SqlEmployeePort();
            var medicalRecordPort = new SqlMedicalRecordPort();
            var appointmentPort = new SqlAppointmentPort();
            var orderPort = new SqlOrderPort();
            var visitPort = new SqlVisitPort();

            // Puertos/Adaptadores faltantes en la carpeta actual del proyecto
            // Se crean stubs mínimos para evitar errores de compilación.
            // Implementación real debe reemplazarse por adaptadores que accedan a la BD.
            var billingPort = new SqlBillingPort();
            var medicalOrderPort = new SqlMedicalOrderPort();

            // Configurar servicios del dominio (UseCases)
            // Usar constructores sin parámetros para coincidir con las implementaciones actuales.
            var createPatient = new C_Patient(patientPort);
            var updatePatient = new U_Patient();
            var searchPatient = new S_Patient();

            var createEmployee = new C_Employee();
            var updateEmployee = new U_Employee();

            var createMedicalRecord = new C_MedicalRecord();
            var updateMedicalRecord = new U_MedicalRecord();
            var searchMedicalRecord = new S_MedicalRecord();

            var createAppointment = new C_Appointment();
            var createOrder = new C_Order();
            var searchOrder = new S_Order();

            var createBilling = new C_Billings();
            var createVisit = new C_Visit();

            // Crear casos de uso compuestos (wrappers locales) que aceptan las dependencias creadas arriba.
            var receptionistUseCase = new ReceptionistUseCase(
                createPatient,
                updatePatient,
                searchPatient,
                createAppointment,
                searchOrder,
                searchMedicalRecord,
                createVisit
            );

            var adminUseCase = new AdminUseCase(
                createEmployee,
                updateEmployee,
                searchPatient,
                searchMedicalRecord,
                searchOrder
            );

            var doctorUseCase = new DoctorUseCase(
                searchPatient,
                createMedicalRecord,
                updateMedicalRecord,
                createOrder,
                searchOrder,
                createVisit
            );

            // BillingUseCase real según la firma conocida: (C_Billings, PatientValidator)
            var billingUseCase = new BillingUseCase(
                createBilling,
                new PatientValidator()
            );

            // Guardar en el service locator
            ServiceLocator.SetReceptionistUseCase(receptionistUseCase);
            ServiceLocator.SetAdminUseCase(adminUseCase);
            ServiceLocator.SetDoctorUseCase(doctorUseCase);
            ServiceLocator.SetBillingUseCase(billingUseCase);
        }
    }

    /// <summary>
    /// Service Locator para acceso a los casos de uso
    /// </summary>
    public static class ServiceLocator
    {
        private static ReceptionistUseCase? _receptionistUseCase;
        private static AdminUseCase? _adminUseCase;
        private static DoctorUseCase? _doctorUseCase;
        private static BillingUseCase? _billingUseCase;

        public static void SetReceptionistUseCase(ReceptionistUseCase useCase) => _receptionistUseCase = useCase;
        public static ReceptionistUseCase? GetReceptionistUseCase() => _receptionistUseCase;

        public static void SetAdminUseCase(AdminUseCase useCase) => _adminUseCase = useCase;
        public static AdminUseCase? GetAdminUseCase() => _adminUseCase;

        public static void SetDoctorUseCase(DoctorUseCase useCase) => _doctorUseCase = useCase;
        public static DoctorUseCase? GetDoctorUseCase() => _doctorUseCase;

        public static void SetBillingUseCase(BillingUseCase useCase) => _billingUseCase = useCase;
        public static BillingUseCase? GetBillingUseCase() => _billingUseCase;
    }

