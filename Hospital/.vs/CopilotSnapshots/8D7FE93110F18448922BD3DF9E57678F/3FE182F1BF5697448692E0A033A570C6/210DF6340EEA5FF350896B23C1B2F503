using System;
using Hospital.domain.model;
using Hospital.domain.services;

namespace Hospital.application.usecases
{
    /// <summary>
    /// UseCase para el personal de Soporte de Información.
    /// Responsable de mantener integridad de datos e inventarios:
    /// - CRUD sobre medicamentos, procedimientos y ayudas diagnósticas.
    /// - Registro de incidencias/soporte técnico.
    /// </summary>
    public class InformationSupportUseCase
    {
        // Medicamentos
        private readonly C_OrderMedicine _createMedicine;
        private readonly U_OrderMedicine _updateMedicine;
        private readonly S_OrderMedicine _selectMedicine;

        // Procedimientos
        private readonly C_OrderProcedure _createProcedure;
        private readonly U_OrderProcedure _updateProcedure;
        private readonly S_OrderProcedure _selectProcedure;

        // Ayudas diagnósticas
        private readonly C_OrderHelp _createHelp;
        private readonly U_OrderHelp _updateHelp;
        private readonly S_OrderHelp _selectHelp;

        // Servicio de soporte (registro de tickets / asistencia)
        private readonly SupportService _supportService;

        public InformationSupportUseCase(
            C_OrderMedicine createMedicine,
            U_OrderMedicine updateMedicine,
            S_OrderMedicine selectMedicine,
            C_OrderProcedure createProcedure,
            U_OrderProcedure updateProcedure,
            S_OrderProcedure selectProcedure,
            C_OrderHelp createHelp,
            U_OrderHelp updateHelp,
            S_OrderHelp selectHelp,
            SupportService supportService)
        {
            _createMedicine = createMedicine ?? throw new ArgumentNullException(nameof(createMedicine));
            _updateMedicine = updateMedicine ?? throw new ArgumentNullException(nameof(updateMedicine));
            _selectMedicine = selectMedicine ?? throw new ArgumentNullException(nameof(selectMedicine));

            _createProcedure = createProcedure ?? throw new ArgumentNullException(nameof(createProcedure));
            _updateProcedure = updateProcedure ?? throw new ArgumentNullException(nameof(updateProcedure));
            _selectProcedure = selectProcedure ?? throw new ArgumentNullException(nameof(selectProcedure));

            _createHelp = createHelp ?? throw new ArgumentNullException(nameof(createHelp));
            _updateHelp = updateHelp ?? throw new ArgumentNullException(nameof(updateHelp));
            _selectHelp = selectHelp ?? throw new ArgumentNullException(nameof(selectHelp));

            _supportService = supportService ?? throw new ArgumentNullException(nameof(supportService));
        }

        // ---------- Medicamentos ----------
        public void AddMedicine(Order_medicine medicine)
        {
            if (medicine == null) throw new ArgumentNullException(nameof(medicine));
            if (medicine.Item <= 0) throw new ArgumentException("El costo (Item) del medicamento debe ser mayor a 0.");
            // Evitar duplicados: si ya existe número de orden lanzar excepción
            if (_selectMedicine.FindByNumOrder(medicine) != null)
                throw new InvalidOperationException("Ya existe una orden de medicamento con ese número.");
            _createMedicine.Create(medicine);
        }

        public void UpdateMedicine(Order_medicine medicine)
        {
            if (medicine == null) throw new ArgumentNullException(nameof(medicine));
            if (medicine.Item < 0) throw new ArgumentException("El costo (Item) del medicamento no puede ser negativo.");
            _updateMedicine.Update(medicine);
        }

        public Order_medicine GetMedicine(Order_medicine query) => _selectMedicine.FindByNumOrder(query);

        // ---------- Procedimientos ----------
        public void AddProcedure(Order_procedure procedure)
        {
            if (procedure == null) throw new ArgumentNullException(nameof(procedure));
            if (procedure.Amount <= 0) throw new ArgumentException("El monto del procedimiento debe ser mayor a 0.");
            if (_selectProcedure.FindByNumOrder(procedure) != null)
                throw new InvalidOperationException("Ya existe una orden de procedimiento con ese número.");
            _createProcedure.Create(procedure);
        }

        public void UpdateProcedure(Order_procedure procedure)
        {
            if (procedure == null) throw new ArgumentNullException(nameof(procedure));
            if (procedure.Amount < 0) throw new ArgumentException("El monto del procedimiento no puede ser negativo.");
            _updateProcedure.Update(procedure);
        }

        public Order_procedure GetProcedure(Order_procedure query) => _selectProcedure.FindByNumOrder(query);

        // ---------- Ayudas diagnósticas ----------
        public void AddHelp(Order_help help)
        {
            if (help == null) throw new ArgumentNullException(nameof(help));
            if (help.Amount <= 0) throw new ArgumentException("El monto de la ayuda diagnóstica debe ser mayor a 0.");
            if (_selectHelp.FindByNumOrder(help) != null)
                throw new InvalidOperationException("Ya existe una orden de ayuda diagnóstica con ese número.");
            _createHelp.Create(help);
        }

        public void UpdateHelp(Order_help help)
        {
            if (help == null) throw new ArgumentNullException(nameof(help));
            if (help.Amount < 0) throw new ArgumentException("El monto de la ayuda diagnóstica no puede ser negativo.");
            _updateHelp.Update(help);
        }

        public Order GetHelp(Order_help query) => _selectHelp.FindByNumOrder(query);

        // ---------- Soporte técnico / incidencias ----------
        /// <summary>
        /// Registra una incidencia o solicitud de asistencia técnica.
        /// </summary>
        public void RegisterSupportTicket(string requesterUser, string summary, string details)
        {
            if (string.IsNullOrWhiteSpace(requesterUser)) throw new ArgumentException("Usuario solicitante es obligatorio.", nameof(requesterUser));
            if (string.IsNullOrWhiteSpace(summary)) throw new ArgumentException("Resumen de la incidencia es obligatorio.", nameof(summary));

            var ticket = new SupportTicket
            {
                Id = Guid.NewGuid().ToString("N"),
                Requester = requesterUser,
                Summary = summary,
                Details = details ?? string.Empty,
                CreatedAt = DateTime.Now,
                Status = "Open"
            };

            _supportService.CreateTicket(ticket);
        }
    }

    // --- Tipos auxiliares mínimos para soporte (modelos simples) ---
    public class SupportTicket
    {
        public string Id { get; set; } = string.Empty;
        public string Requester { get; set; } = string.Empty;
        public string Summary { get; set; } = string.Empty;
        public string Details { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public string Status { get; set; } = "Open";
    }
}
