using Hospital.domain.model;
using System;
using System.Net.Mail;

namespace Hospital.application.validators
{
    public class PatientValidator
    {
        public ValidationResult Validate(Patient patient)
        {
            if (patient == null)
                return ValidationResult.Fail("Paciente nulo.");

            // Número de identificación (Id_patient) requerido
            if (string.IsNullOrWhiteSpace(patient.Id_patient))
                return ValidationResult.Fail("El número de identificación del paciente es obligatorio.");

            // Nombre completo
            var nombre = patient.Name1?.Name ?? patient.Name;
            if (string.IsNullOrWhiteSpace(nombre))
                return ValidationResult.Fail("El nombre completo del paciente es obligatorio.");

            // Fecha de nacimiento: no futura, no mayor a 150 años
            var nacimiento = patient.Birth1?.Birth != default ? patient.Birth1?.Birth : patient.Birth;
            if (nacimiento == null || nacimiento == default(DateTime))
                return ValidationResult.Fail("La fecha de nacimiento es obligatoria.");
            if (nacimiento > DateTime.Now || nacimiento < DateTime.Now.AddYears(-150))
                return ValidationResult.Fail("La fecha de nacimiento no es válida.");

            // Dirección
            var direccion = patient.Direction1?.Direction ?? patient.Direction;
            if (!string.IsNullOrWhiteSpace(direccion) && direccion.Length > 100)
                return ValidationResult.Fail("La dirección es demasiado larga (máximo 100 caracteres).");

            // Teléfono: 10 dígitos (se comprueba contacto de emergencia primero si existe)
            long telefono = 0;
            if (patient.Contact?.Cellphone != default) telefono = patient.Contact.Cellphone;
            if (telefono == 0) telefono = patient.Cellphone1?.Cellphone != default ? patient.Cellphone1.Cellphone : patient.Cellphone;
            var telefonoStr = telefono != 0 ? telefono.ToString() : string.Empty;
            if (string.IsNullOrWhiteSpace(telefonoStr) || telefonoStr.Length != 10)
                return ValidationResult.Fail("El número de teléfono debe tener 10 dígitos.");

            // Correo electrónico: opcional, si está debe ser válido
            string email = null;
            try
            {
                if (patient.Email1?.Email != null) email = patient.Email1.Email.Address;
                else if (patient.Email != null) email = patient.Email.Address;
            }
            catch { email = null; } 

            if (!string.IsNullOrWhiteSpace(email) && !IsValidEmail(email))
                return ValidationResult.Fail("El correo electrónico no es válido.");

            // Contacto de emergencia obligatorio según reglas de dominio (C_Patient lo requiere)
            if (patient.Contact == null || string.IsNullOrWhiteSpace(patient.Contact.Relation) || string.IsNullOrWhiteSpace(patient.Contact.Name1?.Name))
                return ValidationResult.Fail("El paciente debe tener un contacto de emergencia con nombre y relación.");

            return ValidationResult.Success();
        }

        private bool IsValidEmail(string email)
        {
            try
            {
                var addr = new MailAddress(email);
                return true;
            }
            catch
            {
                return false;
            }
        }
    }
}