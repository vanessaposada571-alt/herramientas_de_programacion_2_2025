using Hospital.domain.model;
using Hospital.domain.ports;
using System;
using System.Data;
using Microsoft.Data.SqlClient;

namespace Hospital.infraestructure.adapters.output
{
    public class SqlOrderPort : Order_port
    {
        private SqlConnection GetConn() => new SqlConnection(Config.SqlConnectionString);

        public Order FindByIDOrder(Order order)
        {
            if (order == null) return null;
            const string sql = @"
                SELECT o.OrderId
                FROM dbo.Orders o
                WHERE o.OrderId = @orderId";

            using var cn = GetConn();
            cn.Open();
            using var cmd = new SqlCommand(sql, cn);
            cmd.Parameters.AddWithValue("@orderId", order.IdOrder1);
            using var rd = cmd.ExecuteReader(CommandBehavior.SingleRow);
            if (!rd.Read()) return null;

            return new Order { IdOrder1 = rd["OrderId"] != DBNull.Value ? Convert.ToInt32(rd["OrderId"]) : 0 };
        }

        public Order FindByNumOrderA1(Order orderGrl)
        {
            // No existe tabla específica para buscar por NumOrderA en el esquema genérico de Orders.
            return null;
        }

        public Order FindByNumOrderP1(Order orderGrl)
        {
            // No existe tabla específica para buscar por NumOrderP en el esquema genérico de Orders.
            return null;
        }

        public Order FindByNumOrder(Order orderGrl)
        {
            // Usar el mismo comportamiento que FindByIDOrder: buscar por OrderId
            return FindByIDOrder(orderGrl);
        }

        public void Save(Order orderGrl)
        {
            if (orderGrl == null) throw new ArgumentNullException(nameof(orderGrl));

            // La tabla Orders en el nuevo esquema solo contiene OrderId (IDENTITY).
            // Insertamos una fila vacía para obtener un OrderId y lo asignamos al modelo.
            const string sql = @"
                INSERT INTO dbo.Orders DEFAULT VALUES;
                SELECT CAST(SCOPE_IDENTITY() AS INT);";

            using var cn = GetConn();
            cn.Open();
            using var cmd = new SqlCommand(sql, cn);
            var newId = (int)cmd.ExecuteScalar();
            orderGrl.IdOrder1 = newId;
        }

        public void Update(Order orderGrl)
        {
            // No hay columnas para actualizar en la tabla Orders por ahora.
            throw new NotSupportedException("Update no está soportado para Orders en el esquema actual.");
        }

        public void Search(Order orderGrl)
        {
            // Alias a FindByIDOrder
            FindByIDOrder(orderGrl);
        }
    }
}